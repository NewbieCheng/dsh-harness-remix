{
  "name": "dsh-hello-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal DSH UI plugin: one input-row button and one settings section.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
